#!/usr/bin/env bash
# drain-verify — drain the deferred-verification queue written by defer-verify. Runs nightly via
# launchd, and opportunistically whenever a director notices the blocking resource freeing up.
#
# For each pending entry: run its precheck (skip entry if the resource is still busy), then run the
# anchor SEQUENTIALLY (local-substrate rule: one heavy verifier at a time). Pass -> status=done;
# fail -> stays pending with fails+1. Every outcome is appended to the day's report for the morning
# report to ingest. Entries' `run` commands must be self-contained (bring their own env, e.g.
# `direnv exec . just ...`).
#
# Usage: drain-verify [--dry-run]
set -uo pipefail
Q="${VERIFY_DEBT:-$HOME/.claude/verify-debt.jsonl}"
REPORT_DIR="${VERIFY_DEBT_REPORTS:-$HOME/.claude/verify-debt-reports}"
LOCK="$Q.lock"
DRY="${1:-}"
[ -s "$Q" ] || { echo "drain-verify: queue empty"; exit 0; }
mkdir -p "$REPORT_DIR"
REPORT="$REPORT_DIR/$(date +%F).log"

mkdir "$LOCK" 2>/dev/null || { echo "drain-verify: another drain holds $LOCK — exiting"; exit 0; }
trap 'rmdir "$LOCK" 2>/dev/null' EXIT

note() { echo "$(date +%FT%T%z) $*" | tee -a "$REPORT"; }

ran=0; passed=0; failed=0; skipped=0
for id in $(jq -r 'select(.status=="pending") | .id' "$Q"); do
  entry=$(jq -c --arg id "$id" 'select(.id==$id)' "$Q" | head -1)
  cwd=$(echo "$entry" | jq -r .cwd)
  runcmd=$(echo "$entry" | jq -r .run)
  precheck=$(echo "$entry" | jq -r .precheck)
  entnote=$(echo "$entry" | jq -r .note)

  if [ ! -d "$cwd" ]; then
    note "STALE   $id ($entnote): cwd gone ($cwd) — marking stale, needs re-queue against a live worktree"
    newstatus="stale"
  elif [ -n "$precheck" ] && ! (cd "$cwd" && bash -c "$precheck" >/dev/null 2>&1); then
    note "BUSY    $id ($entnote): precheck says resource not free — skipping this drain"
    skipped=$((skipped+1)); continue
  elif [ "$DRY" = "--dry-run" ]; then
    note "DRY     $id ($entnote): would run: $runcmd"
    continue
  else
    ran=$((ran+1))
    log="$REPORT_DIR/$id.out"
    if (cd "$cwd" && bash -c "$runcmd" >"$log" 2>&1); then
      passed=$((passed+1)); newstatus="done"
      note "PASS    $id ($entnote)"
    else
      failed=$((failed+1)); newstatus="pending"
      note "FAIL    $id ($entnote): anchor red — output in $log; stays queued"
      # A failed `just e2e-isolated` run deliberately keeps its stack up for inspection
      # (ports 8787/3000, PlanetScale branch, Redis lease, .e2e-isolated.json). Left alone it
      # poisons every e2e entry after it in this drain — port collisions and dying-stack API
      # errors recorded as anchor FAILs — fake evidence of real breakage. The runner's
      # own clean recipe is the sanctioned teardown; guard on its state file so non-e2e entries
      # are untouched, and never kill by name.
      if [ -f "$cwd/.e2e-isolated.json" ]; then
        if (cd "$cwd" && bash -c "direnv exec . just e2e-isolated-clean" >>"$log" 2>&1); then
          note "RECLAIM $id: failed isolated stack torn down (e2e-isolated-clean exit 0)"
        else
          note "RECLAIM-FAILED $id: e2e-isolated-clean exited non-zero — inspect $log before the next e2e entry"
        fi
      fi
    fi
  fi

  # Settle delay: e2e/dev-stack teardown from the entry just run winds down asynchronously;
  # without a pause the NEXT entry's pgrep-based precheck sees the dying processes and
  # false-BUSY skips (2026-08-01: 2 entries skipped 1s after a PASS).
  [ "${newstatus:-}" = "done" ] || [ "${newstatus:-}" = "pending" ] && sleep 20

  tmp=$(mktemp)
  jq -c --arg id "$id" --arg st "$newstatus" --arg ts "$(date +%FT%T%z)" \
     'if .id==$id then .status=$st | .last_run=$ts | (if $st=="pending" then .fails+=1 else . end) else . end' \
     "$Q" > "$tmp" && mv "$tmp" "$Q"
done

note "SUMMARY ran=$ran passed=$passed failed=$failed skipped=$skipped pending_left=$(jq -rs '[.[]|select(.status=="pending")]|length' "$Q")"

# Escalation (2026-08-20 — audit finding: the queue was write-only; fails=51 entries cycled
# silently and a 0-pass drain was just a log line). Two thresholds turn debt into a surfaced
# action item: fails>=5 or pending age>=14d. Output goes to (a) ESCALATION lines in the daily
# report, (b) a regenerated ESCALATIONS.md the morning report / session-start sweeps read,
# (c) a macOS notification so a human sees it without reading logs. Escalated entries stay
# pending — the action is "fix the anchor or retire the entry with a reason", never auto-drop.
ESC="$REPORT_DIR/ESCALATIONS.md"
now_epoch=$(date +%s)
esc_json=$(jq -c --argjson now "$now_epoch" '
  select(.status=="pending") |
  (.ts | sub("[+-][0-9]{4}$"; "Z") | fromdateiso8601? // 0) as $born |
  (if $born > 0 then (($now - $born) / 86400 | floor) else -1 end) as $age |
  select((.fails // 0) >= 5 or $age >= 14) |
  {id, note, fails: (.fails // 0), age_days: $age, cwd}' "$Q")
if [ -n "$esc_json" ]; then
  {
    echo "# verify-debt escalations — $(date +%F) (regenerated by drain-verify each run)"
    echo "# Rule: fails>=5 or pending>=14d. For each: fix the anchor, or retire the entry with a reason (edit status to 'retired'). Do not let these recycle."
    echo "$esc_json" | jq -r '"- [\(.id)] fails=\(.fails) age=\(.age_days)d — \(.note) (cwd: \(.cwd))"'
  } > "$ESC"
  esc_count=$(echo "$esc_json" | grep -c .)
  note "ESCALATION $esc_count pending entr$( [ "$esc_count" -eq 1 ] && echo y || echo ies) past thresholds — see $ESC"
  osascript -e "display notification \"$esc_count verify-debt entries need attention (fails>=5 or >=14d) — see ESCALATIONS.md\" with title \"drain-verify\"" >/dev/null 2>&1 || true
else
  rm -f "$ESC"
fi
if [ "$ran" -gt 0 ] && [ "$passed" -eq 0 ]; then
  note "HEADLINE zero anchors passed this drain ($ran ran) — queue health is red, not quiet"
  osascript -e "display notification \"0/$ran deferred anchors passed this drain\" with title \"drain-verify\"" >/dev/null 2>&1 || true
fi
[ "$failed" -eq 0 ]
