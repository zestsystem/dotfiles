#!/bin/sh
# stdin-from FILE CMD [ARGS...]: run CMD with FILE as stdin.
# Use instead of an inline `sh -c '...exec "$@" < "$f"'` launcher: Claude Code cannot inspect
# inline -c scripts that end in exec "$@", so it holds them for a critical-path-removal prompt,
# which stalls an unattended session.
f="$1"; shift
exec "$@" < "$f"
