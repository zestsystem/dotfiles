#!/usr/bin/env python3
"""PermissionRequest hook: answer every remaining Bash prompt with a denial so unattended sessions never stall.

In bypassPermissions mode the only Bash prompts left are critical-path removal checks (rm/rmdir that could
reach /, ~, a repository root, or an inline script Claude Code cannot inspect). Denying keeps the session
moving: the agent gets the message and rewrites the command with literal, guarded paths.
"""
import json, sys

try:
    event = json.load(sys.stdin)
except Exception:
    sys.exit(0)  # unreadable input: fall back to the normal prompt
if event.get("permission_mode") in ("default", "acceptEdits", "plan"):
    sys.exit(0)  # attended modes: Mike chose to be asked, so let the normal prompt show
message = (
    "Auto-denied by permission-request-guard (unattended mode): this command was held for a critical-path "
    "removal check. Rewrite it so Claude Code can inspect it: use literal paths, guard variables as "
    '"${DIR:?}", and avoid inline `sh -c` scripts (use ~/.config/claude-code/bin/stdin-from FILE CMD... '
    "for stdin redirection). Do not retry the same command."
)
print(json.dumps({
    "hookSpecificOutput": {
        "hookEventName": "PermissionRequest",
        "decision": {"behavior": "deny", "message": message},
    }
}))
