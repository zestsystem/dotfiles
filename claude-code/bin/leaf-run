#!/usr/bin/env bash
# leaf-run — ledger wrapper for bash-launched leaf agents (codex exec, headless claude/kimi wrappers).
# Records launch + completion in the machine-local registry so leaf liveness is a query, not a memory
# (PROTOCOL.md "Leaf run ledger"). Harness-tracked subagents (Agent tool) skip this — the harness ledgers them.
#
# Usage: leaf-run --issue <id> --lane <lane> [--expect "<expected output>"] -- <command...>
# Pair with: leaf-sweep (reconcile starts vs completions; INTERRUPTED candidates = dead PID, no end event).
set -uo pipefail
REG="${LEAF_REGISTRY:-$HOME/.claude/leaf-registry.jsonl}"
issue="" lane="" expect=""
while [ $# -gt 0 ]; do
  case "$1" in
    --issue)  issue="$2"; shift 2 ;;
    --lane)   lane="$2"; shift 2 ;;
    --expect) expect="$2"; shift 2 ;;
    --) shift; break ;;
    *) echo "leaf-run: unknown arg '$1' (args go before --, command after)" >&2; exit 2 ;;
  esac
done
[ $# -gt 0 ] || { echo "usage: leaf-run --issue <id> --lane <lane> [--expect <output>] -- <cmd...>" >&2; exit 2; }

# Account-scoping guard (Mike, 2026-09-18: "utc work on utc accounts only; voidpet work on
# voidpet accounts only" — PROTOCOL.md lane table). A Claude-family launch from a project
# tree must bill that project's account; the slot login is volatile state, so read it per
# launch. Fails CLOSED for projects with a known designation; unknown projects pass with a
# note. Scar: week-of-Sep-16 voidpet builds billed the UTC-overflow slot unnoticed.
case "$1" in
  claude|claude-mk|*/claude|*/claude-mk)
    slot_home="${CLAUDE_CONFIG_DIR:-$HOME/.claude}"
    [ "${1##*/}" = "claude-mk" ] && slot_home="${CLAUDE_CONFIG_DIR:-$HOME/.claude-mk}"
    # Ask the CLI, never a config file (2026-09-24 scar): `oauthAccount` in ~/.claude.json read
    # mike@voidpet.com while the default slot was actually logged in as the UTC account, and the
    # default slot has no `$slot_home/.claude.json` at all, so the old jq read came back empty.
    # The default slot is queried with CLAUDE_CONFIG_DIR unset, exactly as `claude` runs it.
    if [ "$slot_home" = "$HOME/.claude" ]; then
      slot_email=$(env -u CLAUDE_CONFIG_DIR claude auth status 2>/dev/null | jq -r '.email // empty')
    else
      slot_email=$(CLAUDE_CONFIG_DIR="$slot_home" claude auth status 2>/dev/null | jq -r '.email // empty')
    fi
    echo "leaf-run: slot '$slot_home' bills '${slot_email:-<unknown>}'" >&2
    case "$PWD" in
      "$HOME/projects/work/utc"*)
        if [ -z "$slot_email" ] || [ "$slot_email" = "mike@voidpet.com" ]; then
          echo "leaf-run: BLOCKED — UTC work must bill a UTC account; slot '$slot_home' is logged in as '${slot_email:-<none>}'." >&2
          exit 3
        fi ;;
      "$HOME/projects/work/voidpet-poc"*)
        if [ "$slot_email" != "mike@voidpet.com" ]; then
          echo "leaf-run: BLOCKED — voidpet work must bill the voidpet account; slot '$slot_home' is logged in as '${slot_email:-<none>}'." >&2
          echo "leaf-run: create/use the voidpet slot: CLAUDE_CONFIG_DIR=\$HOME/.claude-voidpet (login: CLAUDE_CONFIG_DIR=~/.claude-voidpet claude login)" >&2
          exit 3
        fi ;;
    esac ;;
esac

"$@" &
pid=$!
run="$(date +%s)-$pid"
# Fields are TRUNCATED on purpose (2026-08-17 repair): $* carries the whole leaf prompt, which made
# start records ~47KB. An append that large is no longer a single atomic write, so a concurrent
# leaf-run interleaved into one and left two unparseable lines — degrading leaf-sweep, the fan-in
# guard's mechanical half, to "reconciliation may be INCOMPLETE". Records stay small enough to append
# atomically; the ledger's job is liveness pairing, and the full prompt lives in the leaf's own log.
jq -cn --arg ev start --arg run "$run" --arg ts "$(date +%FT%T%z)" --argjson pid "$pid" \
      --arg issue "$issue" --arg lane "$lane" --arg expect "$expect" --arg cwd "$PWD" --arg cmd "$*" \
      '{ev:$ev,run:$run,ts:$ts,pid:$pid,issue:$issue,lane:$lane,
        expect:($expect[0:400]),cwd:$cwd,cmd:($cmd[0:800]),
        truncated:(($expect|length)>400 or ($cmd|length)>800)}' >> "$REG"

wait "$pid"
rc=$?
jq -cn --arg ev end --arg run "$run" --arg ts "$(date +%FT%T%z)" --argjson rc "$rc" \
      '{ev:$ev,run:$run,ts:$ts,rc:$rc}' >> "$REG"
exit "$rc"
