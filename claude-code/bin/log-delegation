#!/usr/bin/env bash
# Validating appender for ~/.claude/delegation-log.jsonl — use this INSTEAD of raw echo >>.
# Rejects unknown executors/cats (the enum drift that fragments the weekly digest) and
# placeholder ext_tokens. Usage: log-delegation '<json line>'
# Also fires open-experiment reminders (reads ~/.claude/experiments.json, machine-local):
# this is the one chokepoint every delegation passes in every runtime, so experiment
# triggers land here instead of relying on directors re-reading scorecard prose.
set -euo pipefail
LOG="$HOME/.claude/delegation-log.jsonl"
EXP="$HOME/.claude/experiments.json"
EXECUTORS="haiku sonnet fable-5-1-low fable-5-1 sonnet-explore opus opus-5 opus-explore fable k3 codex-gpt-5.5-low codex-gpt-5.5-high codex-gpt-5.5-xhigh codex-gpt-5.6-sol-low codex-gpt-5.6-sol-medium codex-gpt-5.6-sol-high codex-gpt-5.6-sol-xhigh codex-gpt-5.6-sol-director-high codex-gpt-5.6-terra-low codex-gpt-5.6-terra-medium codex-gpt-5.6-terra-high codex-gpt-5.6-luna-low codex-gpt-5.6-luna-medium codex-gpt-6-astra-low codex-gpt-6-astra-medium codex-gpt-6-astra-high codex-gpt-6-astra-director-solo codex-gpt-6-astra-director-multi fable-5-director fable-5-1-director opus-5-director opus-5-5 opus-5-5-director k3-director grokbot-v1 grok-atlas-director grok-sieve-reviewer grok-scout-investigator grok-forge-builder jev-1.13"
CATS="coding/back-end coding/front-end-web coding/front-end-mobile coding/infra exploration writing"
GRADES="A+ A A- B+ B B- C+ C C- D F"
DISPOSITIONS="N/A-availability F-infra INC BLOCKED PENDING-review"
line="$1"
echo "$line" | jq -e . > /dev/null || { echo "REJECTED: not valid JSON" >&2; exit 1; }
# Date hygiene (2026-07-28: log carried future-dated lines from UTC-clock callers, and task=null lines):
# default a missing date to the LOCAL machine date; reject dates in the future.
today=$(date +%F)
line=$(echo "$line" | jq -c --arg d "$today" 'if (.date // "") == "" then .date = $d else . end')
d=$(echo "$line" | jq -r '.date')
[[ "$d" > "$today" ]] && { echo "REJECTED: date '$d' is in the future — use the local machine date ($today), not UTC" >&2; exit 1; }
ex=$(echo "$line" | jq -r '.executor // empty')
cat_=$(echo "$line" | jq -r '.cat // empty')
ext=$(echo "$line" | jq -r '.ext_tokens // "null"')
task=$(echo "$line" | jq -r '.task // empty')
if [ -n "$ex" ]; then
  echo " $EXECUTORS " | grep -q " $ex " || { echo "REJECTED: executor '$ex' not in canon: $EXECUTORS" >&2; exit 1; }
  echo " $CATS " | grep -q " $cat_ " || { echo "REJECTED: cat '$cat_' not in canon: $CATS" >&2; exit 1; }
  { [ -z "$task" ] || [ "$task" = "null" ]; } && { echo "REJECTED: task is missing/null — the log is the queryable record; name the task" >&2; exit 1; }
  case "$ex" in codex-*)
    [ "$ext" = "1" ] && { echo "REJECTED: ext_tokens=1 is a placeholder — use the real codex usage-footer count or null" >&2; exit 1; }
    [ "$ext" = "0" ] && { echo "REJECTED: ext_tokens=0 on a codex lane is a placeholder — use the real usage-footer count, or null if genuinely unavailable" >&2; exit 1; }
  ;; esac
  echo "$line" | jq -e 'has("taste")' > /dev/null || echo "WARN: missing taste score (required since 2026-07-06)" >&2
  # Grade vocabulary (2026-09-22): the grade field was unvalidated and 61/2868 historical rows
  # carried junk — bare taste numbers ('5','4'), null, and free text — which silently skews every
  # routing average computed off this log. Letter grades OR one of the disposition tokens that
  # encode the protocol's capability-vs-availability distinction; anything else is rejected.
  if echo "$line" | jq -e 'has("grade")' > /dev/null; then
    g=$(echo "$line" | jq -r '.grade // "null"')
    echo " $GRADES $DISPOSITIONS " | grep -q " $g " || {
      echo "REJECTED: grade '$g' not in canon." >&2
      echo "  grades:       $GRADES" >&2
      echo "  dispositions: $DISPOSITIONS  (availability/infra failures and unfinished work — NOT capability grades)" >&2
      echo "  note: a bare number is a TASTE score, not a grade — put it in \"taste\"; put detail in the note, not the grade." >&2
      exit 1; }
  fi
fi
echo "$line" >> "$LOG" && echo "logged"

# --- Open-experiment triggers (non-fatal; never blocks the append above) ---
if [ -f "$EXP" ] && [ -n "$cat_" ]; then
  expfield=$(echo "$line" | jq -r '.exp // empty')
  if [ -n "$expfield" ]; then
    jq -e --arg id "$expfield" '.experiments[] | select(.id == $id)' "$EXP" > /dev/null 2>&1 \
      || echo "WARN: exp '$expfield' not in experiments.json (closed experiment, or a typo — check the id)" >&2
  fi
  today=$(date +%F)
  while IFS=$'\t' read -r id stale cats shadow quota reminder; do
    echo " $cats " | grep -q " $cat_ " || continue
    done_n=$(jq -r --arg id "$id" --arg sh "$shadow" 'select(.exp == $id and .executor == $sh) | 1' "$LOG" 2>/dev/null | wc -l | tr -d ' ')
    if [ "$done_n" -ge "$quota" ]; then
      echo "EXPERIMENT $id: quota reached ($done_n/$quota) — conclude it: move the verdict to the scorecard's routing adjustments and delete the entry from experiments.json" >&2
    elif [[ "$today" > "$stale" ]]; then
      echo "EXPERIMENT $id: STALE since $stale with $done_n/$quota datapoints — run it deliberately on the next matching task or close it with a scorecard note" >&2
    elif [ "$expfield" != "$id" ]; then
      # Full reminder text costs ~150 tokens per experiment per log line in a director's context;
      # default to ids only (LOG_DELEGATION_VERBOSE=1 restores the text; it lives in experiments.json).
      if [ -n "${LOG_DELEGATION_VERBOSE:-}" ]; then
        echo "EXPERIMENT $id ACTIVE for cat '$cat_' ($done_n/$quota done, stale $stale): $reminder" >&2
      else
        active="${active:+$active, }$id $done_n/$quota"
      fi
    fi
  done < <(jq -r '.experiments[] | [.id, .stale, (.trigger_cats | join(" ")), .shadow_executor, (.quota | tostring), .reminder] | @tsv' "$EXP" 2>/dev/null)
  [ -n "${active:-}" ] && echo "open experiments for cat '$cat_': $active (triggers: ~/.claude/experiments.json)" >&2
  true
fi
