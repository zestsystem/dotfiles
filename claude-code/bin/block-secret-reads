#!/usr/bin/env bash
# block-secret-reads — Claude Code PreToolUse(Bash) guard.
# Refuses commands that would print a secret VALUE into the session transcript.
#
# Scar 2026-09-25: `direnv exec . doppler secrets get X ... 2>&1 >/dev/null | grep ...` was meant as an
# access check; the redirect did not take effect through the wrapper and a service-account private key
# landed in the transcript (key had to be rotated). Rules in memory had not prevented it, so this is a gate.
#
# Matches the WHOLE command string, not a prefix, so wrappers (direnv exec, nix develop -c, bash -c,
# ssh host "...") cannot slip past. It is a tripwire against accidents, not a sandbox against a
# determined bypass. False positives (e.g. grepping for these phrases) are accepted as the price.
# Exit 2 blocks the tool call; stderr is shown to Claude.
set -uo pipefail

cmd="$(jq -r '.tool_input.command // empty' 2>/dev/null)" || exit 0
[ -n "$cmd" ] || exit 0
c="$(printf '%s' "$cmd" | tr '\n\t' '  ')"

has() { printf '%s' "$c" | grep -Eq -- "$1"; }

block() {
  {
    echo "BLOCKED by block-secret-reads: $1"
    echo "This command could print a secret VALUE into the transcript. Safe alternatives:"
    echo "  - Does it exist?   doppler secrets --only-names -p P -c C   |   bao kv metadata get kv/P/C"
    echo "  - Which one is it? inject it into a process that prints ONLY non-secret fields, e.g."
    echo "      doppler run -p P -c C -- node -e 'console.log(JSON.parse(process.env.X).private_key_id)'"
    echo "  - Copying a secret between stores: write the command for the human to run in their terminal."
  } >&2
  exit 2
}

# --- Doppler -------------------------------------------------------------------------------------
has 'doppler[[:space:]]+secrets[[:space:]]+(get|download|set|upload|delete|substitute)([[:space:]]|$|[;|&)"'"'"'])' \
  && block "doppler secrets get/download/set/delete/substitute print secret values"
# Bare `doppler secrets` (optionally followed by flags) prints the full name+value table.
if has 'doppler[[:space:]]+secrets([[:space:]]+-|[[:space:]]*($|[;|&)"'"'"']))' && ! has -- '--only-names'; then
  block "bare \`doppler secrets\` prints every value (add --only-names)"
fi

# --- Env dumps (anywhere, and especially under a secrets runner) ----------------------------------
has '(^|[;|&(`]|&&|\|\|)[[:space:]]*(env|printenv)[[:space:]]*($|[;|&)`])' \
  && block "bare env/printenv dumps every environment variable"
has '(doppler[[:space:]]+run|secrets-run|run-with-secrets?(\.sh)?)[^;|&]*--[[:space:]]+(env|printenv|set|export|declare)([[:space:]]|$|[;|&)`"'"'"'])' \
  && block "dumping the environment under a secrets runner"
has '(doppler[[:space:]]+run|secrets-run|run-with-secrets?(\.sh)?)[^;|&]*--[^;|&]*(echo|printf)[^;|&]*\$\{?[A-Za-z_]' \
  && block "echoing a variable under a secrets runner"

# --- OpenBao / Vault ------------------------------------------------------------------------------
has '(bao|vault)[[:space:]]+kv[[:space:]]+get([[:space:]]|$)' \
  && block "bao/vault kv get prints values (use: kv metadata get)"
has '(bao|vault)[[:space:]]+read[[:space:]]+([^;|&]*[[:space:]])?(kv|secret|auth/token/create)' \
  && block "bao/vault read of a secret path"
has 'curl[^;|&]*/v1/kv/data/' && ! has 'curl[^;|&]*-X[[:space:]]*(POST|PUT|PATCH)' \
  && block "direct OpenBao KV read over HTTP"
has 'scripts/secrets/secrets-get' && block "secrets-get prints a secret value"

# --- Dokku runtime config -------------------------------------------------------------------------
has 'dokku[[:space:]]+config(:(show|get|export|bundle|set))?([[:space:]]|$|[;|&)"'"'"'])' \
  && block "dokku config/config:show/get/export/set print values (config:keys is names-only)"

# --- Cloud / OS / password-manager secret readers -------------------------------------------------
has 'gcloud[[:space:]]+secrets[[:space:]]+versions[[:space:]]+access' && block "gcloud secret access"
has 'gcloud[[:space:]]+iam[[:space:]]+service-accounts[[:space:]]+keys[[:space:]]+create' \
  && block "creating a service-account key writes a private key (human-only)"
has 'gcloud[[:space:]]+auth[[:space:]]+(application-default[[:space:]]+)?print-(access|identity)-token' \
  && block "printing a gcloud token"
has 'aws[[:space:]]+secretsmanager[[:space:]]+get-secret-value' && block "AWS Secrets Manager read"
has 'aws[[:space:]]+ssm[[:space:]]+get-parameters?[^;|&]*--with-decryption' && block "AWS SSM decrypted read"
has 'kubectl[^;|&]*get[[:space:]]+secrets?([[:space:]]|$)[^;|&]*-o' && block "kubectl secret dump"
has 'security[[:space:]]+find-(generic|internet)-password[^;|&]*[[:space:]]-[a-zA-Z]*[wg]' \
  && block "macOS Keychain password read"
has '(^|[[:space:];|&(])op[[:space:]]+(read|inject)([[:space:]]|$)' && block "1Password op read/inject"
has '(^|[[:space:];|&(])op[[:space:]]+item[[:space:]]+get[^;|&]*--reveal' && block "1Password reveal"

exit 0
